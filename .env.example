# Copy this file to .env and replace with your own AviationStack access key.
# Get a key at https://aviationstack.com/
FLIGHT_API_KEY=2fc426ca5d6462827a01344e43df465c

# Event store backend: sqlite (local, default) or somee (remote MS SQL on somee.com).
EVENT_STORE_BACKEND=sqlite

# Only required when EVENT_STORE_BACKEND=somee.
# Copy these from somee.com: MS SQL -> your database -> Connection details.
# Map dashboard fields to env vars (do NOT paste the full ADO.NET connection string here):
#   data source  -> SOMEE_SERVER   (e.g. yourdb.mssql.somee.com)
#   initial catalog -> SOMEE_DATABASE (e.g. yourdb)
#   user id -> SOMEE_UID
#   pwd -> SOMEE_PWD
SOMEE_SERVER=
SOMEE_DATABASE=
SOMEE_UID=
SOMEE_PWD=

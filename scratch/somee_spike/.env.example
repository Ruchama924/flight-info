# Paste the connection string copied from somee.com control panel
# (MS SQL -> your database -> Connection details -> Connection string).
#
# somee often gives an ADO-style string WITHOUT a DRIVER= key, e.g.:
# SOMEE_CONNECTION_STRING=workstation id=yourdb.mssql.somee.com;packet size=4096;user id=youruser;pwd=your_password;data source=yourdb.mssql.somee.com;persist security info=False;initial catalog=yourdb;TrustServerCertificate=True
#
# test_connection.py parses that and builds an ODBC string with
# DRIVER={ODBC Driver 18 for SQL Server} + Encrypt=yes;TrustServerCertificate=yes
#
# Or use ODBC keys directly:
# SOMEE_CONNECTION_STRING=SERVER=yourdb.mssql.somee.com;DATABASE=yourdb;UID=youruser;PWD=your_password
SOMEE_CONNECTION_STRING=workstation id=flight-info.mssql.somee.com;packet size=4096;user id=ayala_SQLLogin_1;pwd=7hhk8cl9um;data source=flight-info.mssql.somee.com;persist security info=False;initial catalog=flight-info;TrustServerCertificate=True
